{
  "repo": "redtidev1918/PixivFlow",
  "default_branch": "master",
  "visibility": "public",
  "archived": false,
  "fork": false,
  "template": false,
  "classification": "managed",
  "health": "HEALTHY",
  "health_reasons": [],
  "missing_assets": [],
  "empty_assets": [],
  "release_policy": {
    "kind": "node-library",
    "versioning": {
      "mode": "release-please"
    },
    "build": {
      "test": "npm ci && npm test -- --runInBand --silent",
      "command": "scripts/build-release",
      "version_check": "test \"$(node -p \"require('./package.json').version\")\" = \"$RELEASE_VERSION\" && tar -tzf dist/release/pixivflow-*.tgz >/dev/null"
    },
    "assets": {
      "required": [
        "pixivflow-*.tgz"
      ],
      "optional": []
    },
    "registries": {
      "github": {
        "required": true
      },
      "npm": {
        "required": true,
        "publish": "if npx --yes npm@11 view pixivflow@$RELEASE_VERSION version | grep -Fx \"$RELEASE_VERSION\" >/dev/null; then echo \"pixivflow@$RELEASE_VERSION already published\"; else npx --yes npm@11 publish --provenance --access public --ignore-scripts \"dist/release/pixivflow-$RELEASE_VERSION.tgz\"; fi",
        "verify": "npm view pixivflow@$RELEASE_VERSION version | grep -Fx $RELEASE_VERSION"
      },
      "ghcr": {
        "required": false,
        "context": ".",
        "file": "Dockerfile.scheduler",
        "image": "ghcr.io/redtidev1918/pixivflow",
        "platforms": "linux/amd64,linux/arm64",
        "verify": "docker buildx imagetools inspect ghcr.io/redtidev1918/pixivflow:$RELEASE_VERSION"
      }
    },
    "release": {
      "postRelease": [
        {
          "id": "refresh-download-page",
          "type": "github-workflow",
          "required": true,
          "workflow": "update-download-page.yml",
          "inputs": {
            "tag": "{{tag}}",
            "deploy-docs": "false"
          }
        },
        {
          "id": "deploy-docs",
          "type": "github-workflow",
          "required": true,
          "workflow": "static.yml",
          "ref": "default"
        }
      ]
    },
    "retention": {
      "stable": 1,
      "prerelease": 1,
      "failed_draft": 2,
      "pruneStable": true
    },
    "checksums": true,
    "sbom": true,
    "repository": {
      "git": {
        "productionOperations": {
          "base": "default",
          "branches": [
            "chore/cutover-*",
            "ops/*",
            "release/*",
            "hotfix/*"
          ],
          "requireLatestBase": true,
          "operations": {
            "cutover": {
              "branches": [
                "chore/cutover-*"
              ],
              "allowedPaths": [
                "Dockerfile",
                "Dockerfile.scheduler",
                "docker-compose.yml",
                "docker-compose.apprise.example.yml"
              ]
            }
          }
        }
      }
    }
  },
