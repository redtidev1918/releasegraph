  "classification": "managed",
  "health": "HEALTHY",
  "health_reasons": [],
  "missing_assets": [],
  "empty_assets": [],
  "release_policy": {
    "kind": "hybrid",
    "versioning": {
      "mode": "release-please"
    },
    "build": {
      "test": "python -m pip install -r requirements-dev.txt && python -m pytest -q --no-cov -o log_cli=false",
      "matrix": [
        {
          "runner": "ubuntu-latest",
          "command": "scripts/build-release",
          "version_check": "./dist/release/telepost-linux-x64 --version | grep -F \"telepost $RELEASE_VERSION\""
        },
        {
          "runner": "windows-latest",
          "command": "scripts/build-release",
          "version_check": "./dist/release/telepost-windows-x64.exe --version | grep -F \"telepost $RELEASE_VERSION\""
        },
        {
          "runner": "macos-14",
          "command": "scripts/build-release",
          "version_check": "./dist/release/telepost-macos-arm64 --version | grep -F \"telepost $RELEASE_VERSION\""
        }
      ]
    },
    "assets": {
      "required": [
        "telepost-linux-x64",
        "telepost-windows-x64.exe",
        "telepost-macos-arm64",
        "telepost-*-linux-x64.tar.gz",
        "telepost-*-macos-arm64.tar.gz",
        "telepost-*-windows-x64.zip"
      ],
      "optional": []
    },
    "registries": {
      "github": {
        "required": true
      },
      "ghcr": {
        "required": true,
        "context": ".",
        "file": "Dockerfile",
        "image": "ghcr.io/redtidev1918/telepost",
        "platforms": "linux/amd64,linux/arm64",
        "verify": "docker buildx imagetools inspect ghcr.io/redtidev1918/telepost:$RELEASE_VERSION"
      }
    },
    "release": {
      "postRelease": [
        {
          "id": "refresh-download-page",
          "type": "github-workflow",
          "required": true,
          "workflow": "update-download-page.yml",
          "inputs": {
            "tag": "{{tag}}",
            "deploy-docs": "false"
          }
        },
        {
          "id": "publish-pypi",
          "type": "github-workflow",
          "required": true,
          "workflow": "pypi-publish.yml",
          "inputs": {
            "tag": "{{tag}}"
          }
        },
        {
          "id": "deploy-production",
          "type": "github-workflow",
          "required": true,
          "workflow": "deploy-fly.yml",
          "inputs": {
            "tag": "{{tag}}"
          }
        },
        {
          "id": "deploy-docs",
          "type": "github-workflow",
          "required": true,
          "workflow": "static.yml",
          "ref": "default"
        },
        {
          "id": "notify-deploy-repo",
          "type": "github-workflow",
          "required": false,
          "workflow": "notify-deploy.yml",
          "ref": "default",
          "inputs": {
            "tag": "{{tag}}"
          }
        }
      ]
    },
    "retention": {
      "stable": 1,
      "prerelease": 1,
      "failed_draft": 2,
      "pruneStable": true
    },
    "checksums": true,
    "sbom": true,
    "repository": {
      "git": {
        "productionOperations": {
          "base": "default",
          "branches": [
            "chore/cutover-*",
            "ops/*",
            "release/*",
            "hotfix/*"
          ],
          "requireLatestBase": true,
          "operations": {
            "cutover": {
              "branches": [
                "chore/cutover-*"
              ],
              "allowedPaths": [
                "fly.toml",
                "docker-compose.yml",
                "Dockerfile"
              ]
            }
          }
        }
      }
    }
  },
