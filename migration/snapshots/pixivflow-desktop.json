{
  "repo": "redtidev1918/pixivflow-desktop",
  "default_branch": "main",
  "visibility": "public",
  "archived": false,
  "fork": false,
  "template": false,
  "classification": "managed",
  "health": "HEALTHY",
  "health_reasons": [],
  "missing_assets": [],
  "empty_assets": [],
  "release_policy": {
    "kind": "binary",
    "versioning": {
      "mode": "release-please"
    },
    "build": {
      "test": "npm ci && npm run test:frontend && npm run test:version",
      "matrix": [
        {
          "runner": "macos-latest",
          "command": "scripts/build-release",
          "version_check": "ls dist/release/PixivFlow-Desktop-v${RELEASE_VERSION}-macos-*.dmg >/dev/null"
        },
        {
          "runner": "windows-2022",
          "command": "scripts/build-release",
          "version_check": "ls dist/release/PixivFlow-Desktop-v${RELEASE_VERSION}-windows-*-setup.exe >/dev/null"
        },
        {
          "runner": "ubuntu-latest",
          "command": "scripts/build-release",
          "version_check": "ls dist/release/PixivFlow-Desktop-v${RELEASE_VERSION}-linux-*.deb >/dev/null"
        }
      ]
    },
    "assets": {
      "required": [
        "PixivFlow-Desktop-v*-macos-*.dmg",
        "PixivFlow-Desktop-v*-windows-*-setup.exe",
        "PixivFlow-Desktop-v*-linux-*.deb"
      ],
      "optional": [
        "PixivFlow-Desktop-v*-linux-*.AppImage"
      ]
    },
    "registries": {
      "github": {
        "required": true
      }
    },
    "release": {
      "notes": {
        "language": "zh"
      },
      "postRelease": [
        {
          "id": "refresh-download-page",
          "type": "github-workflow",
          "required": true,
          "workflow": "update-download-page.yml",
          "inputs": {
            "tag": "{{tag}}",
            "deploy-docs": "false"
          }
        },
        {
          "id": "deploy-docs",
          "type": "github-workflow",
          "required": true,
          "workflow": "docs.yml",
          "ref": "default"
        }
      ]
    },
    "retention": {
      "stable": 1,
      "prerelease": 1,
      "failed_draft": 2,
      "pruneStable": true
    },
    "checksums": true,
    "sbom": false,
    "repository": {
      "git": {
        "productionOperations": {
          "base": "default",
          "branches": [
            "chore/cutover-*",
            "ops/*",
            "release/*",
            "hotfix/*"
          ],
          "requireLatestBase": true
        }
      }
    }
  },
