{
  "comment": "Asset pattern language fixture. `matches` expectations are CPython fnmatch's, because fnmatch is the language definition the contract is written against. Both release_infra.health (fnmatch) and internal/health (path.Match) must reproduce every row, and both must reject every entry in `invalid`. Characters outside this language are rejected precisely because the two engines disagree about them: [!a] means 'not a' to fnmatch and the literal characters ! and a to path.Match, and [^a] is the exact opposite pair. Within the language the two agree: an exhaustive 236,496-pair comparison over literals, * and ? found no difference. No name here contains '/': GitHub release asset names cannot, so a pattern can never need to cross a separator.",
  "valid": [
    "*",
    "app-*.tgz",
    "*.whl",
    "*.tar.gz",
    "pixivflow-*.tgz",
    "NekoTime-macOS-v*.zip",
    "DAViewer-v*.apk",
    "telepost-windows-x64.exe",
    "deploy-linux-amd64.tar.gz",
    "RELEASE-METADATA.json",
    "SHA256SUMS",
    "a?p.tgz",
    "??",
    "a*b*c",
    "app-*",
    "*-linux-x64.tar.gz",
    "*a",
    "a*",
    "**",
    "app-1.2.3.tgz",
    "APP-*.tgz",
    "app-*.TGZ"
  ],
  "invalid": [
    {
      "pattern": "app-[0-9].tgz",
      "why": "character classes are not in the language"
    },
    {
      "pattern": "app-[!0-9].tgz",
      "why": "negated classes are not in the language; fnmatch and path.Match would invert each other"
    },
    {
      "pattern": "app-[^0-9].tgz",
      "why": "negated classes are not in the language; fnmatch and path.Match would invert each other"
    },
    {
      "pattern": "app-*[",
      "why": "an unterminated class is not in the language"
    },
    {
      "pattern": "a\\*.tgz",
      "why": "backslash has no quoting meaning, and both engines would differ"
    },
    {
      "pattern": "dist/*.tar.gz",
      "why": "a path separator is not in the language; path.Match would not cross it and fnmatch would"
    },
    {
      "pattern": "a]b",
      "why": "a stray ] is not in the language"
    },
    {
      "pattern": "a!b",
      "why": "! is reserved"
    },
    {
      "pattern": "a^b",
      "why": "^ is reserved"
    },
    {
      "pattern": "",
      "why": "empty pattern"
    }
  ],
